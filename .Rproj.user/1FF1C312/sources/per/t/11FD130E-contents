# ---------------------------------------------------------- #
# need to load/unload packages to avoid namespace collisions
# ---------------------------------------------------------- #

f2 = function(){
  loaded.pkgs = (.packages())
  if("FLasherEMSRR" %in% loaded.pkgs){
    detach("package:FLasherEMSRR", unload = TRUE)
  }
  if("FLasher" %in% loaded.pkgs){
    detach("package:FLasher", unload = TRUE)
  }
  library(FLasher)
  
  ctrl = FLasher::fwdControl(data.frame(year = ac(2000:2017),
                                             value = as.numeric(fbar(ple4)[, ac(2000:2017)]),
                                             quant = "fbar"),iters = 100)
  
    setAs('FLBiol', 'FLBiolcpp',
          function(from) {
            if("year" %in% names(from@rec@params))
              srparams <- window(as(from@rec@params, "FLQuant"),
                                 start=dims(from)$minyear, end=dims(from)$maxyear)
            else
              srparams <- as(from@rec@params, "FLQuant")
            new("FLBiolcpp",
                name = name(from),
                desc = desc(from),
                range = range(from),
                n = n(from),
                m = m(from),
                wt = wt(from),
                mat = mat(from),
                fec = fec(from),
                spwn = spwn(from),
                srmodel = SRModelName(from@rec@model),
                srparams = srparams)
          }
    )
    out = FLasher::fwd(object = ple4ext, sr=srr2, control = ctrl,verbose = T)
    detach("package:FLasher", unload = TRUE)
    return(out)
}


f1 = function(){
  loaded.pkgs = (.packages())
  if("FLasherEMSRR" %in% loaded.pkgs){
    detach("package:FLasherEMSRR", unload = TRUE)
  }
  if("FLasher" %in% loaded.pkgs){
    detach("package:FLasher", unload = TRUE)
  }
  library(FLasherEMSRR)
  
  ctrl = FLasherEMSRR::fwdControl(data.frame(year = ac(2000:2017),
                                             value = as.numeric(fbar(ple4)[, ac(2000:2017)]),
                                             quant = "fbar"),iters = 100)
  setAs('FLBiol', 'FLBiolcpp',
        function(from) {
          if("year" %in% names(from@rec@params))
            srparams <- window(as(from@rec@params, "FLQuant"),
                               start=dims(from)$minyear, end=dims(from)$maxyear)
          else
            srparams <- as(from@rec@params, "FLQuant")
          new("FLBiolcpp",
              name = name(from),
              desc = desc(from),
              range = range(from),
              n = n(from),
              m = m(from),
              wt = wt(from),
              mat = mat(from),
              fec = fec(from),
              spwn = spwn(from),
              srmodel = as.character(from@rec@model)[[3]],
              srparams = srparams)
        })
  out = FLasherEMSRR::fwd(object = ple4ext, sr=srr, control = ctrl,verbose = T)
  detach("package:FLasherEMSRR", unload = TRUE)
  return(out)
}



library(microbenchmark)

check_speed = microbenchmark(f1(),f2(),times = 20L)
check_speed

df = data.frame(call = check_speed$expr,
           time = check_speed$time)

boxplot(time~call,df)
library(collapse)
df_med = df |> fgroup_by(call) |> fsummarise(median = median(time))
df_med$median[1]/df_med$median[2]

FLasherEMSRR = f1()
FLasher = f2()

stks <- FLStocks(list(FLasher = FLasher, FlasherEMSRR = FLasherEMSRR))
