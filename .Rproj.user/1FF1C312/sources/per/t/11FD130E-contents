data(ple4)
DIM <- dim(ple4)
df <- as.data.frame(ssb(ple4))[-DIM[2],]
names(df)[names(df)=="data"] <- "ssb"
df$rec <- c(rec(ple4))[-1]

set.seed(1234)
df$sst <- c(arima.sim(model = list(ar = 0.5), n = nrow(df), sd = 2) + 15)
plot(df$sst, df$rec, t = "l")


gamfit <- gam(formula = rec ~ s(ssb, k = 4, fx = 1) + s(sst, k = 10), data = df, family = gaussian(link = "log"))
plot(gamfit, pages = 1)
summary(gamfit)

it = 100
ple4ext = propagate(ple4, it)
srr <- as.FLSR(ple4ext)

# put covariates in params slot
sst = rec(srr) %=% (+0.25*(1:60)+3*sin(1:60/pi)+rnorm(100*dim(rec(srr))[2],17,sd = 5))
plot(sst)
# a = array(0,dim = c(1,length(2000:2017),it),dimnames = list(params = "dummy.param",year = 2000:2017,
#                                      iter = 1:it))
b = array(as.numeric(sst[1,1,]),dim = c(1,length(2000:2017),it),dimnames = list(params = "sst",year = 2000:2017,
                                                                                iter = 1:it))
#ab = DescTools::Abind(a,b,along = 1)
#names(dimnames(ab)) = c("params","year","iter")

names(dimnames(b)) = c("params","year","iter")

# only put sst in there
params(srr) = FLPar(b)

# prediction function (dummy.parame used at placeholder for non-existent params; only covars)
gampredict <- function(ssb, params){
  newdat <- data.frame(ssb = as.numeric(ssb),
                       params)
  colnames(newdat) = colnames(gamfit$model)[-1]
  pred = predict(gamfit, newdata = newdat, type = "response")
  pred = FLQuant(as.vector(pred))
  return(pred)
}

model(srr) = as.formula("rec~gampredict(ssb,params)")
# put covar in parameter slot
params(srr) = FLPar(b)

ctrl = FLasherEMSRR::fwdControl(data.frame(year = ac(2000:2017),
                             value = as.numeric(fbar(ple4)[, ac(2000:2017)]),
                             quant = "fbar"),iters = 100)

# project forward
#detach("package:FLasher", unload=TRUE)
ple4gam2 <- FLasherEMSRR::fwd(object = ple4ext,
                              sr=srr, control = ctrl,verbose = T)

sst = rec(srr) %=% (+0.55*(1:60)+rnorm(100*dim(rec(srr))[2],17,sd = 5))
plot(sst)
# a = array(0,dim = c(1,length(2000:2017),it),dimnames = list(params = "dummy.param",year = 2000:2017,
#                                      iter = 1:it))
b = array(as.numeric(sst[1,1,]),dim = c(1,length(2000:2017),it),dimnames = list(params = "sst",year = 2000:2017,
                                                                                iter = 1:it))
#ab = DescTools::Abind(a,b,along = 1)
#names(dimnames(ab)) = c("params","year","iter")

names(dimnames(b)) = c("params","year","iter")

# only put sst in there
params(srr) = FLPar(b)

ple4gam3 <- FLasherEMSRR::fwd(object = ple4ext,
                              sr=srr, control = ctrl,verbose = T)


stks <- FLStocks(list(orig = ple4, gam1 = ple4gam2, gam2 = ple4gam3))
plot(stks) 

