data(ple4)
DIM <- dim(ple4)
df <- as.data.frame(ssb(ple4))[-DIM[2],]
names(df)[names(df)=="data"] <- "ssb"
df$rec <- c(rec(ple4))[-1]

set.seed(1234)
df$sst <- c(arima.sim(model = list(ar = 0.5), n = nrow(df), sd = 2) + 15)
plot(df$sst, df$rec, t = "l")


gamfit <- gam(formula = rec ~ s(ssb, k = 4, fx = 1) + s(sst, k = 10), data = df, family = gaussian(link = "log"))
plot(gamfit, pages = 1)
summary(gamfit)

srr <- as.FLSR(propagate(ple4, 100))

# prediction function (dummy.parame used at placeholder for non-existent params; only covars)
gampredict <- function(ssb, dummy.param, sst){
  newdat <- data.frame(ssb = as.numeric(ssb), sst = as.numeric(sst))
  pred = predict(gamfit, newdata = newdat, type = "response")
  pred = FLQuant(as.vector(pred))
  return(pred)
}

# model list
gamsrr <- function() {
  list(model = rec~gampredict(ssb, dummy.param, sst))
}

