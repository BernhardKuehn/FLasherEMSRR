# try a more complex example

# generate some data
set.seed(42)
N = 50
env = 0.1*(1:N)+rnorm(N,mean = 0,sd = 2)

plot(env,type = "l")

rec = 1E6/(abs(1+0.2*env)) * rlnorm(N,1,0.3)
plot(env,rec)
plot(rec,type = "l")

df = data.frame(rec = rec,env = env)

# fit an earth model
library(earth)
library(pdp)

mod = earth(rec~env,data = df)
rec_pred = as.numeric(predict(mod,df))
plot(rec,type = "l")
lines(rec_pred,col = "red")
pdp_out = partial(mod,pred.var = "env",ice = F)
plot(df$env,df$rec)
lines(pdp_out[,c("env","yhat")],col = "red")
# looks ok

# wrap model in a predict function

mod_func = function(mod,newdata){
  return(as.numeric(stats::predict(mod,newdata = newdata)))
}

# setup new environment
evn=new.env()
evn$df=df # add data to the environment
evn$mod = mod # add model to the environment
# 3. wrap the function call in an expression
expr=quote(mod_func(mod = evn$mod,newdata=evn$df))

# 4. call the function as expression with the specified environment
C_test2(expr,evn)
# works!!!

