# ---------------------------------------- #
# flexible recruitment definitions using
# FLCore and FLasherEMSRR
# ---------------------------------------- #
# use the forked FLasher_emsrr, will overwrite the existing FLasher for the moment
#devtools::install_github("BernhardKuehn/FLasherEMSRR")
library(mgcv)
library(FLCore)
library(ggplotFL)
library(FLasherEMSRR)
data(ple4)
DIM <- dim(ple4)
df <- as.data.frame(ssb(ple4))[-DIM[2],]
names(df)[names(df)=="data"] <- "ssb"
df$rec <- c(rec(ple4))[-1]
set.seed(1234)
df$sst <- c(arima.sim(model = list(ar = 0.5), n = nrow(df), sd = 2) + 15)
plot(df$sst, df$rec, t = "l")
gamfit <- gam(formula = rec ~ s(ssb, k = 4, fx = 1) + s(sst, k = 10), data = df, family = gaussian(link = "log"))
plot(gamfit, pages = 1)
summary(gamfit)
it = 100
ple4ext = propagate(ple4, it)
srr <- as.FLSR(ple4ext)
# put covariates in params slot
sst = rec(ple4ext) %=% +0.07*(1:60)+rnorm(100*dim(rec(srr))[2],17,sd = 5)
