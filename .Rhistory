desc = desc(from),
range = range(from),
n = n(from),
m = m(from),
wt = wt(from),
mat = mat(from),
fec = fec(from),
spwn = spwn(from),
srmodel = as.character(from@rec@model)[[3]],
srparams = srparams)
})
FLasherEMSRR::fwd(object = ple4ext, sr=srr, control = ctrl,verbose = T)
detach("package:FLasherEMSRR", unload = TRUE)
}
